{
  "name": "dujap-frontend",
  "private": true,
  "version": "0.1",
  "type": "module",
  "scripts": {
    "dev:front": "vite",
    "dev:server": "tsx watch src/api/index.ts",
    "dev": "concurrently \"npm run dev:front\" \"npm run dev:server\"",
    "build:front": "vite build",
    "build:server": "swc src/api -d dist/api && node fix-build-imports.js",
    "build": "npm run build:front && npm run build:server",
    "type-check": "tsc --noEmit",
    "start:front": "vite preview",
    "start": "concurrently \"vite preview\" \"node dist/api/src/api/index.js\""
  },
  "dependencies": {
    "@lit-labs/router": "^0.1.4",
    "@lit-labs/ssr": "^4.0.0",
    "@lit/task": "^1.0.3",
    "@material/web": "^2.4.1",
    "@types/express": "^5.0.6",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "fs": "0.0.1-security",
    "lit": "^3.3.2",
    "node-fetch": "^3.3.2",
    "urlpattern-polyfill": "^10.1.0"
  },
  "devDependencies": {
    "@swc/cli": "0.7.9",
    "@swc/core": "^1.15.8",
    "@types/cors": "^2.8.19",
    "@types/node": "^25.0.3",
    "@types/node-fetch": "^2.6.13",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  }
}
